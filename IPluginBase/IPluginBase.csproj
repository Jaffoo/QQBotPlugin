<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>0.0.1</Version>
    <Authors>Jaffoo</Authors>
    <Company>none</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Jaffoo/QQBotPlugin</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Jaffoo/QQBotPlugin</PackageProjectUrl>
    <PackageReleaseNotes>支持插件依赖第三方库，在插件同级目录创建libs文件夹，在创建一个和插件name属性相同的目录，把依赖放入其中即可</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleTables" Version="2.7.0" />
    <PackageReference Include="FluentScheduler" Version="5.5.1" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
    <PackageReference Include="UnifyBot" Version="1.3.5" />
  </ItemGroup>

</Project>
